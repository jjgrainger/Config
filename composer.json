{
    "name": "jjgrainger/config",
    "description": "A lightweight PHP configuration library for loading configuration from files or directories.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Config\\": "src/"
        }
    },
    "authors": [
        {
            "name": "jjgrainger",
            "email": "github@jjgrainger.co.uk"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "phpcs": "phpcs --standard=psr2 src",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpunit": "phpunit"
    }
}
